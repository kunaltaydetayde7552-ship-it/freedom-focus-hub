<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#0D3829">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌿"
        android:textSize="56sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/textBlockedTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You've got your freedom back!"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/textBlockedNotice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This app is blocked during your focus session."
        android:textColor="#BBF7D0"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnReturnHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Return to Work"
        android:backgroundTint="#FFFFFF"
        android:textColor="#0D3829"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:textStyle="bold" />

</LinearLayout>
